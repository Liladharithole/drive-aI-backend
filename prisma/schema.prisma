generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Folder {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid      String    @unique @db.Char(36)
  name      String    @db.VarChar(255)
  color     String?   @default("#4285F4") @db.VarChar(20)

  // Logical reference to Central-Core User.uuid
  userUuid  String    @map("user_uuid") @db.Char(36)

  // Self-Referential Hierarchy (Nested sub-folders)
  parentId  BigInt?   @map("parent_id") @db.UnsignedBigInt
  parent    Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderHierarchy")

  // Drive Features
  isStarred Boolean   @default(false) @map("is_starred")
  isTrashed Boolean   @default(false) @map("is_trashed")
  trashedAt DateTime? @map("trashed_at")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userUuid, parentId])
  @@index([userUuid, isTrashed])
  @@map("folders")
}

model File {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique @db.Char(36)
  name          String    @db.VarChar(255)
  originalName  String    @map("original_name") @db.VarChar(255)
  mimeType      String    @map("mime_type") @db.VarChar(100)
  size          BigInt    @db.UnsignedBigInt
  extension     String    @db.VarChar(20)
  storageDriver String    @default("local") @map("storage_driver") @db.VarChar(20)
  storageKey    String    @map("storage_key") @db.VarChar(500)
  storageUrl    String?   @map("storage_url") @db.VarChar(1000)

  // Ownership & Location
  userUuid      String    @map("user_uuid") @db.Char(36)
  folderUuid    String?   @map("folder_uuid") @db.Char(36)

  // Drive Features (Starred, Trashed)
  isStarred     Boolean   @default(false) @map("is_starred")
  isTrashed     Boolean   @default(false) @map("is_trashed")
  trashedAt     DateTime? @map("trashed_at")

  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([userUuid, folderUuid])
  @@index([userUuid, isTrashed])
  @@map("files")
}
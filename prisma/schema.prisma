generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model Folder {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid      String    @unique @db.Char(36)
  name      String    @db.VarChar(255)
  color     String?   @default("#4285F4") @db.VarChar(20)

  // Logical reference to Central-Core User.uuid
  userUuid  String    @map("user_uuid") @db.Char(36)

  // Self-Referential Hierarchy (Nested sub-folders)
  parentId  BigInt?   @map("parent_id") @db.UnsignedBigInt
  parent    Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderHierarchy")

  // Drive Features
  isStarred Boolean   @default(false) @map("is_starred")
  isTrashed Boolean   @default(false) @map("is_trashed")
  trashedAt DateTime? @map("trashed_at")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userUuid, parentId])
  @@index([userUuid, isTrashed])
  @@map("folders")
}

model File {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique @db.Char(36)
  name          String    @db.VarChar(255)
  originalName  String    @map("original_name") @db.VarChar(255)
  mimeType      String    @map("mime_type") @db.VarChar(100)
  size          BigInt    @db.UnsignedBigInt
  extension     String    @db.VarChar(20)
  storageDriver String    @default("local") @map("storage_driver") @db.VarChar(20)
  storageKey    String    @map("storage_key") @db.VarChar(500)
  storageUrl    String?   @map("storage_url") @db.VarChar(1000)
  embedding     String?   @db.LongText

  // Ownership & Location
  userUuid      String    @map("user_uuid") @db.Char(36)
  folderUuid    String?   @map("folder_uuid") @db.Char(36)

  // Drive Features (Starred, Trashed)
  isStarred     Boolean   @default(false) @map("is_starred")
  isTrashed     Boolean   @default(false) @map("is_trashed")
  trashedAt     DateTime? @map("trashed_at")

  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([userUuid, folderUuid])
  @@index([userUuid, isTrashed])
  @@map("files")
}

enum ShareAccessLevel {
  VIEWER
  EDITOR
}

model FileShare {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String           @unique @db.Char(36)
  
  // What is being shared
  fileUuid        String?          @map("file_uuid") @db.Char(36)
  folderUuid      String?          @map("folder_uuid") @db.Char(36)
  
  // Who shared it & who receives it
  sharedByUuid    String           @map("shared_by_uuid") @db.Char(36)
  sharedWithEmail String           @map("shared_with_email") @db.VarChar(255)
  accessLevel     ShareAccessLevel @map("access_level") @default(VIEWER)
  
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([fileUuid, sharedWithEmail])
  @@unique([folderUuid, sharedWithEmail])
  @@index([sharedWithEmail])
  @@map("file_shares")
}

model PublicLink {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String    @unique @db.Char(36)
  accessKey    String    @unique @map("access_key") @db.VarChar(255) // unique random token
  
  fileUuid     String?   @map("file_uuid") @db.Char(36)
  folderUuid   String?   @map("folder_uuid") @db.Char(36)
  
  createdBy    String    @map("created_by") @db.Char(36)
  passwordHash String?   @map("password_hash") @db.VarChar(255) // optional password lock
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("public_links")
}

model FileActivityLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid      String   @unique @db.Char(36)
  userUuid  String   @map("user_uuid") @db.Char(36)
  fileUuid  String   @map("file_uuid") @db.Char(36)
  
  action    String   @db.VarChar(50) // UPLOAD, DOWNLOAD, RENAME, STAR, TRASH, DELETE, etc.
  details   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userUuid])
  @@index([fileUuid])
  @@map("file_activity_logs")
}

model FolderActivityLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique @db.Char(36)
  userUuid   String   @map("user_uuid") @db.Char(36)
  folderUuid String   @map("folder_uuid") @db.Char(36)
  
  action     String   @db.VarChar(50) // CREATE, RENAME, MOVE, STAR, TRASH, DELETE, etc.
  details    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userUuid])
  @@index([folderUuid])
  @@map("folder_activity_logs")
}

model ShareActivityLog {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String   @unique @db.Char(36)
  userUuid        String   @map("user_uuid") @db.Char(36) // Actor who shared/revoked
  
  itemType        String   @map("item_type") @db.VarChar(20) // FILE or FOLDER
  itemUuid        String   @map("item_uuid") @db.Char(36)
  sharedWithEmail String?  @map("shared_with_email") @db.VarChar(255) // Recipient email (if user share)
  action          String   @db.VarChar(50) // SHARE, REVOKE, CREATE_PUBLIC_LINK, PUBLIC_ACCESS
  details         String?  @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userUuid])
  @@index([itemUuid])
  @@map("share_activity_logs")
}

model FileAiSummary {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String   @unique @db.Char(36)
  fileUuid     String   @unique @map("file_uuid") @db.Char(36)
  
  summary      String   @db.Text
  keyTakeaways String   @map("key_takeaways") @db.Text // JSON stringified array of key bullet points
  documentType String?  @map("document_type") @db.VarChar(50) // E.g. Invoice, Contract, Resume, Report
  language     String?  @db.VarChar(20)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("file_ai_summaries")
}

model FileDocumentChunk {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique @db.Char(36)
  fileUuid   String   @map("file_uuid") @db.Char(36)
  chunkIndex Int      @map("chunk_index")
  
  content    String   @db.Text
  embedding  String   @db.LongText // JSON array of float vector embeddings (768 dimensions)
  tokenCount Int      @map("token_count")
  
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([fileUuid])
  @@map("file_document_chunks")
}

model AiChatHistory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid      String   @unique @db.Char(36)
  fileUuid  String   @map("file_uuid") @db.Char(36)
  userUuid  String   @map("user_uuid") @db.Char(36)
  
  question  String   @db.Text
  answer    String   @db.Text
  sources   String?  @db.Text // JSON list of chunk UUIDs/indexes used
  
  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileUuid, userUuid])
  @@map("ai_chat_histories")
}

model ChatSession {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid      String   @unique @db.Char(36)
  userUuid  String   @map("user_uuid") @db.Char(36)
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages  ChatMessage[]

  @@index([userUuid])
  @@map("chat_sessions")
}

model ChatMessage {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  uuid        String      @unique @db.Char(36)
  sessionUuid String      @map("session_uuid") @db.Char(36)
  sender      String      @db.VarChar(10) // "user" or "ai"
  text        String      @db.LongText
  citations   String?     @db.Text // JSON stringified array of { fileUuid, fileName, chunkIndex }
  createdAt   DateTime    @default(now()) @map("created_at")

  session     ChatSession @relation(fields: [sessionUuid], references: [uuid], onDelete: Cascade)

  @@index([sessionUuid])
  @@map("chat_messages")
}